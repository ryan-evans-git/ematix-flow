#!/bin/bash
# ematix-flow distributed engine bootstrap.
#
# Role: ${role}
# Coordinator: ${coordinator_ip}
# Scale: ${scale_factor}
# Bench bucket: ${bench_bucket}
#
# Builds flow-worker from /opt/ematix/ematix-flow (cloned by base.sh),
# pulls the TPC-H parquet for this scale factor from S3 to local disk
# (the campaign binary and every worker read the SAME local path —
# /opt/ematix/data/sf${scale_factor}/<table>.parquet), and starts
# flow-worker as a systemd service. The coordinator additionally builds
# the campaign orchestrator example.
#
# 2026-07-04 refresh:
#   - fixed flow-worker invocation: the binary takes `--bind ADDR --port
#     PORT` as SEPARATE flags; the May kit passed `--bind 0.0.0.0:50051`,
#     which produced an unparseable "0.0.0.0:50051:50051" socket addr and
#     would have crash-looped the service. Never executed; caught in kit
#     review.
#   - added the S3 → local data pull (the May kit never staged data, so
#     the campaign binary's pre-flight would have failed on every node).
#   - coordinator now builds the tpch_distributed_campaign example during
#     bootstrap (the old runbook assumed it existed).
#   - EMAT_* levers intentionally NOT set: production auto-gating. The
#     flow-worker process is solo on its instance, so the partition
#     registry senses live=1 and resolves full cores.

set -euo pipefail
set -uo pipefail
exec > >(tee /var/log/ematix-userdata.log) 2>&1

echo "=== ematix bootstrap: role=${role}: $(date -u +%FT%TZ) ==="

# Build prerequisites: the workspace needs a C toolchain (ring/librdkafka/
# mimalloc build scripts) — rustup alone is NOT enough on a stock AL2023 AMI.
dnf install -y -q gcc gcc-c++ cmake make perl

# Rust toolchain — install for ec2-user (not root) so cargo cache lives
# under /home/ec2-user.
sudo -u ec2-user bash <<'INSTALL_RUST'
if ! command -v rustc >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
fi
source $HOME/.cargo/env
rustc --version
INSTALL_RUST

# TPC-H parquet: pull from the campaign bucket to the local path shared
# by coordinator + workers. S3 layout is a directory per table. We sync
# the ENTIRE table dir into a local per-table dir: that's 1 file for the
# legacy single-file layout, or K `<table>-NNNN.parquet` parts for the
# multi-file ("parted") layout. ematix registers the DIRECTORY, so each
# part becomes its own scan split — the file count the distributed
# planner divides by files_per_task (pinned to 1) to fan a scan out
# across peers. `data_prefix` selects tpch-data (single) vs
# tpch-data-parted (multi-file) without disturbing the other.
mkdir -p /opt/ematix/data/sf${scale_factor}
for t in region nation supplier customer part partsupp orders lineitem; do
  dst="/opt/ematix/data/sf${scale_factor}/$t"
  if [ ! -d "$dst" ] || [ -z "$(ls -A "$dst" 2>/dev/null)" ]; then
    /usr/local/bin/aws s3 cp --recursive \
      "s3://${bench_bucket}/${data_prefix}/sf${scale_factor}/$t/" \
      "$dst/" --only-show-errors
  fi
done
chown -R ec2-user:ec2-user /opt/ematix/data
ls -lhR /opt/ematix/data/sf${scale_factor}/ | head -60

# Build flow-worker (every node). Reuses the cached target dir if present.
# Real cargo exit captured from PIPESTATUS (tail would otherwise mask it).
sudo -u ec2-user bash <<'BUILD'
set -uo pipefail
source $HOME/.cargo/env
cd /opt/ematix/ematix-flow
cargo build --release -p ematix-flow-distributed --bin flow-worker > /tmp/build-worker.log 2>&1 || { echo 'FLOW-WORKER BUILD FAILED'; tail -40 /tmp/build-worker.log; exit 1; }
tail -3 /tmp/build-worker.log
rc=$${PIPESTATUS[0]}
echo "flow-worker build exit: $rc"
exit $rc
BUILD

# Coordinator additionally builds the campaign orchestrator example.
if [ "${role}" = "coordinator" ]; then
  sudo -u ec2-user bash <<'BUILD_CAMPAIGN'
set -uo pipefail
source $HOME/.cargo/env
cd /opt/ematix/ematix-flow
cargo build --release -p ematix-flow-distributed --example tpch_distributed_campaign > /tmp/build-campaign.log 2>&1 || { echo 'CAMPAIGN BUILD FAILED'; tail -40 /tmp/build-campaign.log; exit 1; }
tail -3 /tmp/build-campaign.log
rc=$${PIPESTATUS[0]}
echo "campaign example build exit: $rc"
exit $rc
BUILD_CAMPAIGN
fi

# systemd unit. Coordinator vs worker share the same flow-worker
# binary; the orchestrator just connects to the workers' Flight
# endpoints by IP. NOTE: --bind and --port are separate flags.
cat > /etc/systemd/system/flow-worker.service <<EOF
[Unit]
Description=ematix-flow flow-worker (Arrow Flight peer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/ematix/ematix-flow
Environment=AWS_REGION=${aws_region}
Environment=BENCH_BUCKET=${bench_bucket}
Environment=EMATIX_ROLE=${role}
Environment=EMATIX_COORDINATOR_IP=${coordinator_ip}
Environment=EMATIX_SCALE_FACTOR=${scale_factor}
Environment=RUST_LOG=info
ExecStart=/opt/ematix/ematix-flow/target/release/flow-worker --bind 0.0.0.0 --port 50051
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable flow-worker.service
systemctl start flow-worker.service

# Quick health check
sleep 10
systemctl is-active flow-worker.service || journalctl -u flow-worker.service --no-pager | tail -50

echo "=== ematix bootstrap: done ==="
