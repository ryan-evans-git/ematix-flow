#!/bin/bash
# Trino engine bootstrap. Dispatches to
# infra/distributed-peers/trino/install.sh in the cloned repo.
#
# Role: ${role}
# Coordinator: ${coordinator_ip}
# Bench bucket: ${bench_bucket}
# Glue database: ${glue_database_name}

set -eo pipefail
set -uo pipefail
exec > >(tee /var/log/trino-userdata.log) 2>&1

echo "=== trino bootstrap: role=${role}: $(date -u +%FT%TZ) ==="

INSTALL=/opt/ematix/ematix-flow/infra/distributed-peers/trino/install.sh
if [ ! -x "$INSTALL" ]; then
  echo "FATAL: $INSTALL missing — base userdata didn't clone the repo correctly"
  exit 1
fi

# The install script handles role-specific config (coordinator
# discovery, jvm sizing, glue catalog wire-up).
export AWS_REGION=${aws_region}
export BENCH_BUCKET=${bench_bucket}
export GLUE_DATABASE=${glue_database_name}
export TRINO_SCALE_FACTOR=${scale_factor}

# Terraform passes coordinator_ip="" on the coordinator itself (its IP
# isn't known while its own userdata is being templated) — resolve via IMDS.
COORD="${coordinator_ip}"
if [ -z "$COORD" ]; then
  TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
  COORD=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)
fi

"$INSTALL" --role ${role} --coordinator-host "$COORD"

echo "=== trino bootstrap: done ==="
