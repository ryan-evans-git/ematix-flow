# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Usage: `set -a; source .env; set +a; terraform plan`
#
# The `set -a` makes every variable assigned in the sourced file be
# exported, which is what Terraform's AWS provider reads from.

# IAM user / role access key. Create in AWS Console → IAM → Users →
# Security credentials → Create access key. Grant *only* the permissions
# this campaign needs (see below) — do NOT use the root account.
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Optional. Use only if you went the STS / SSO route (recommended).
# Short-lived; expires when the session does.
# AWS_SESSION_TOKEN=

# Default region. Matches the `aws_region` Terraform variable default.
AWS_REGION=us-east-2

# Optional — pin to a specific profile if you have multiple in
# ~/.aws/config. Leave commented out if you're only using env vars.
# AWS_PROFILE=ematix-flow-test

# ============================================================
# Minimum IAM permissions for this campaign
# ============================================================
# The IAM user/role needs:
#   - AmazonEC2FullAccess        (Phase A)
#   - AmazonS3FullAccess         (Phase B, narrower also works)
#   - AWSLambda_FullAccess       (Phase C)
#   - AmazonEKSClusterPolicy + AmazonEKS Worker + EC2ContainerRegistryFullAccess (Phase D)
#   - IAMFullAccess              (creating per-phase roles)
#
# Tighten later — the campaign creates IAM resources, so the user
# running terraform needs iam:* against the scoped names. For a first
# run, attach `AdministratorAccess` to keep moving; cycle the key
# after teardown if you want belt-and-braces hygiene.
