# Provider + Terraform version pin. Pin majors to whatever the AWS
# provider's current stable line is; pin Terraform to >= 1.6 to get
# `import` blocks and the post-1.5 sane defaults.

terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.70"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}
