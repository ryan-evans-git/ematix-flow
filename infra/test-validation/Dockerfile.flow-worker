# Flow worker image. Used by Phase D (EKS K8sJobExecutor smoke test)
# and Phase C (Lambda container-image deployment, optional).
#
# Multi-stage:
#   1. `builder` — clones the repo, builds the `flow` Rust CLI in
#      release mode + builds the Python wheel via maturin.
#   2. runtime — slim Python image with the CLI + wheel installed,
#      plus the boto3 / kubernetes extras for the executor backends.
#
# Architecture target: linux/amd64 (matches EKS t3.medium and EC2
# c7i nodes; Mac M-series cross-compiles via buildx).

# ============================================================
# Build stage
# ============================================================

FROM --platform=linux/amd64 rust:1.83-slim-bookworm AS builder

# System deps for the Rust build: openssl-dev for tls, pkg-config for
# crate build scripts, libsasl2-dev (rdkafka), libssl-dev, libpq-dev
# (tokio-postgres native fallback), python3.12 + dev headers for the
# maturin wheel build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl pkg-config build-essential clang \
        libssl-dev libsasl2-dev libpq-dev libsqlite3-dev \
        python3 python3-dev python3-pip python3-venv \
        git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build/

# Build the release CLI. RUSTFLAGS targets a generic x86_64-v3 baseline
# (Haswell-and-newer) so the image runs on every modern EC2 instance
# type; we don't bake in AVX-512 because t3.medium nodes (EKS default)
# are Skylake and lack it.
RUN RUSTFLAGS="-C target-cpu=x86-64-v3" \
    cargo build --release --bin flow

# Build the Python wheel via maturin. The cli + library both end up
# in the wheel; the Lambda handler will import this.
RUN pip3 install --break-system-packages maturin \
    && cd crates/ematix-flow-py \
    && maturin build --release --out /build/wheels

# ============================================================
# Runtime stage
# ============================================================

FROM --platform=linux/amd64 python:3.12-slim-bookworm

# Same set of runtime libraries the binary needs at exec time, minus
# build tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 libsasl2-2 libpq5 libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy the Rust CLI binary + the wheel from the builder stage.
COPY --from=builder /build/target/release/flow /usr/local/bin/flow
COPY --from=builder /build/wheels/*.whl /tmp/

# Install the wheel + the executor extras (boto3 for LambdaExecutor +
# S3RunLog, kubernetes for K8sJobExecutor). Pinned versions match
# what's tested locally.
RUN pip install --no-cache-dir /tmp/*.whl \
        boto3==1.40.* \
        kubernetes==31.* \
    && rm /tmp/*.whl

# Non-root user. EKS workloads + Lambda both run as non-root by
# default; matching that surfaces permission issues at build time
# rather than at first run.
RUN useradd --create-home --shell /bin/bash flow
USER flow
WORKDIR /home/flow

# Smoke test: `flow --version` must succeed. Catches missing libs.
RUN flow --version || (echo "flow CLI not runnable in image" && exit 1)

# Default entrypoint = the Rust CLI. K8sJobExecutor passes `args` to
# this; LambdaExecutor (container-image mode) overrides with its
# handler shim.
ENTRYPOINT ["flow"]
