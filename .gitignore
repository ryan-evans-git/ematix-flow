# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# PGO profile data (scripts/pgo/). Profile files are machine-specific
# (host triple, hot-path topology) and ~10-100 MB per training run —
# never commit. Default location is target/pgo-profiles/ which is
# already covered by /target/ above; these patterns catch stray files
# if someone runs `cargo pgo` outside the script.
**/*.profraw
**/*.profdata

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/

# Maturin
wheels/

# mkdocs build output (deployed by .github/workflows/docs.yml)
/site/

# Σ.A1: TPC-H benchmark data (regenerated via
# `cargo run --release -p ematix-flow-core --example tpch_generate`).
# SF=1 is ~1 GB; SF=10 ~10 GB; SF=100 ~100 GB. Never commit.
/examples/tpch/data/

# IDE / editor
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code internal control files
.claude/

# Local environment files (AWS creds for paid campaigns, etc.)
.env
.env.local

# Terraform state + provider binaries (per-machine, not version-controlled)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform/
.terraform.lock.hcl
.terraform-build/
crash.log
crash.*.log

# AWS campaign artefacts (downloaded from S3 ad-hoc, never committed)
/tmp/ematix-campaign-results/
